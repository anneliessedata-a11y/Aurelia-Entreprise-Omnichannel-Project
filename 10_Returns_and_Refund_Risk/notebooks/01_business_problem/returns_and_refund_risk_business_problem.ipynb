      "source": [
        "questions = [\"What is happening?\",\"Where is it happening?\",\"What may explain it?\",\"What can be predicted or prioritised?\",\"What evidence should inform action?\"]  # Define the diagnostic questions.\n",
        "for question in questions: print(f\"- {question}\")  # Display the investigation sequence.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "kpis = [\"volume\",\"rate\",\"value\",\"frequency\",\"time\",\"quality\",\"risk\"]  # Define reusable KPI dimensions.\n",
        "print(\"Candidate KPI dimensions:\", \", \".join(kpis))  # Set the initial measurement frame.\n",
        "print(\"KPI definitions must be validated against dataset fields.\")  # Avoid assuming business meaning before inspection.\n"
